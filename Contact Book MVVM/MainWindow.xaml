<Window x:Class="Contact_Book_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Contact_Book_MVVM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Danh Bạ" FontSize="24" FontWeight="SemiBold" Margin="0, 0, 0, 4"/>
        <!-- Binding Count : lấy từ MainViewModel.Count, còn StringFormat là lấy đưa data vào chuỗi để hiển thị -->
        <TextBlock Grid.Row="0" Text="{Binding Count, StringFormat='Tổng : {0} người'}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="SeaGreen"/>
        
        <Border Grid.Row="1" Background="White" BorderBrush="Blue" BorderThickness="1" Padding="14" Margin="0, 12, 0, 12" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên" VerticalAlignment="Center"/>
                <!-- UpdateSourceTrigger=PropertyChanged : mỗi lần gõ -> cập nhật ViewModel ngay -->
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0, 0, 0, 8" Padding="6"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tuổi" VerticalAlignment="Center"/>
                <!-- UpdateSourceTrigger=PropertyChanged : mỗi lần gõ -> cập nhật ViewModel ngay -->
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Margin="0, 0, 0, 8" Padding="6"/>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="SĐT" VerticalAlignment="Center"/>
                <!-- UpdateSourceTrigger=PropertyChanged : mỗi lần gõ -> cập nhật ViewModel ngay -->
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0, 0, 0, 8" Padding="6"/>
                
                <!-- Command Binding : nút gọi ICommand trên ViewModelm không dùng Click trong .cs -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Content="Thêm" Command="{Binding AddCommand}" Width="88" Height="32" Margin="0, 0, 8, 0"/>
                    <Button Content="Sửa" Command="{Binding UpdateCommand}" Width="88" Height="32" Margin="0, 0, 8, 0"/>
                    <Button Content="Xóa" Command="{Binding DeleteCommand}" Width="88" Height="32" Margin="0, 0, 8, 0"/>
                    <Button Content="Xóa Form" Command="{Binding ClearFormCommand}" Width="88" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Danh sách : ItemSource = ObservableCollection; SelectionItem = người đang chọn để sửa xóa -->
        <Border Grid.Row="2" Background="White" BorderBrush="Blue" BorderThickness="1" CornerRadius="6">
            <ListBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" BorderThickness="0" Padding="4" FontSize="14" Background="Transparent"/>
        </Border>
        
        <!-- Binding Status : thông báo sau khi thêm xóa sửa (ViewModel.Status) -->
        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0, 10, 0, 0" Foreground="SeaGreen" TextWrapping="Wrap" />
    </Grid>
</Window>

<!-- 
Ta có ObservableCollection<T> là danh sách thông minh
Tự động báo cho UI biết khi có thêm/xóa/sửa phần tử 
Giúp ListBox luôn hiển thị đúng dữ liệu mà không cần code thêm gì
-->