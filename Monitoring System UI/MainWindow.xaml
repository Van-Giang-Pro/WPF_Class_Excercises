<Window x:Class="Monitoring_System_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Monitoring_System_UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="200" Width="600" Background="Transparent">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Background="DarkSlateGray"Height="50">
                <Image Source="C:\Users\fs120806\Desktop\Document\Programing Project\Net_Programming\WPF_Class_Exercises\Monitoring System UI\Icon\Monitoring_Icon.png" Width="30" Height="30" VerticalAlignment="Center"/>
                <TextBlock Text="Hệ thống giám sát" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="5 -2 0 0" Foreground="White"/>
            </StackPanel>
            <Grid Height="150" Background="#1A1726">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Margin="20 0 0 0">
                    <TextBlock Text="Nhiệt Độ" FontSize="15" Foreground="Gray"/>
                    <TextBlock Text="72.5 °C" FontSize="25" Foreground="Aqua" Margin="0 10 0 0"/>
                </StackPanel>
                <Rectangle Grid.Column="0" Grid.Row="0" Fill="Black" Width="1" HorizontalAlignment="Right"/>
                <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Margin="20 0 0 0">
                    <TextBlock Text="Áp suất" FontSize="15" Foreground="Gray"/>
                    <TextBlock Text="3.2 Bar" FontSize="25" Foreground="GreenYellow" Margin="0 10 0 0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
</Window>