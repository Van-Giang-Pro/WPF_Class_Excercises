<Window x:Class="Monitoring_System_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Monitoring_System_UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="200" Width="600" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen">
    <!-- Header -->
    <StackPanel>
        <Border CornerRadius="10 10 0 0" BorderBrush="DarkGray" BorderThickness="2 2 2 2" Background="DarkSlateGray">
            <StackPanel Orientation="Horizontal" Background="Transparent" Height="50">
                <Image Source="Icon\Monitoring_Icon.png" Width="30" Height="30" VerticalAlignment="Center" Margin="5 0 0 0"/>
                <TextBlock Text="Hệ thống giám sát" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="5 -2 0 0" Foreground="White"/>
            </StackPanel>
        </Border>
        <!-- Split Columns -->
        <Border CornerRadius="0 0 10 10" BorderBrush="DarkGray" BorderThickness="2 0 2 2" ClipToBounds="True" Background="DarkBlue" Height="145">
            <Grid Height="150" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Right Side -->
                <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Margin="20 0 0 0" Background="Transparent">
                    <TextBlock Text="Nhiệt Độ" FontSize="15" Foreground="Gray"/>
                    <TextBlock Text="72.5 °C" FontSize="25" Foreground="Aqua"/>
                </StackPanel>
                <Rectangle Grid.Column="0" Grid.Row="0" Fill="DarkGray" Width="2" HorizontalAlignment="Right"/>
                <!-- Left Side -->
                <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Margin="20 0 0 0" Background="Transparent">
                    <TextBlock Text="Áp suất" FontSize="15" Foreground="Gray"/>
                    <TextBlock Text="3.2 Bar" FontSize="25" Foreground="GreenYellow"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Window>