<Application x:Class="Navigation_With_Dependency_Injection_And_Factory_Pattern.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Navigation_With_Dependency_Injection_And_Factory_Pattern"
             xmlns:viewmodels="clr-namespace:Navigation_With_Dependency_Injection_And_Factory_Pattern.ViewModels"
             xmlns:views="clr-namespace:Navigation_With_Dependency_Injection_And_Factory_Pattern.Views">

    <Application.Resources>
        <DataTemplate DataType="{x:Type viewmodels:AutoViewModel}">
            <views:AutoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TeachingViewModel}">
            <views:TeachingView/>
        </DataTemplate>
    </Application.Resources>
</Application>
