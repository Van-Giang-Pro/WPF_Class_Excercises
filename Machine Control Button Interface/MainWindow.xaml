<Window x:Class="Machine_Control_Button_Interface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Machine_Control_Button_Interface"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">
        <!-- Chia grid ở ngoài thành 3 hàng -->
        <Grid Margin="15">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Header -->
                <Border Grid.Row="0" Background="#2477c9" CornerRadius="6" Margin="0 0 0 15" Padding="12 8">
                        <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Foreground="White" FontSize="16" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                <TextBlock Text="Machine Control Panel" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        </StackPanel>
                </Border>
                <!-- Button Types -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 15" HorizontalAlignment="Center">
                        <!-- Button nhấn một lần kích hoạt click event -->
                        <Button Content="▶ Start" 
                                Click="BtnStart_Click" 
                                Width="100" 
                                Height="40" 
                                Margin="0 0 20 0" 
                                FontSize="14" 
                                Foreground="DarkCyan" 
                                Background="MediumPurple"/>
                        <!-- Repeat Button nhấn giữ là click liên tục theo interval -->
                        <RepeatButton Content="Jog +" 
                                      Click="BtnJog_OnClick"  
                                      Width="100" Height="40" 
                                      Margin="20 0 20 0" FontSize="14" 
                                      Foreground="DarkCyan" 
                                      Background="GreenYellow" 
                                      Interval="10" 
                                      Delay="300"/>
                        <!-- Toggle Button là nhấn giữ -->
                        <ToggleButton x:Name="LightToggle"
                                      Content="Light : Off" 
                                      Checked="Light_On" 
                                      Unchecked="Light_Off" 
                                      Width="100" Height="40" 
                                      Margin="20 0 20 0" 
                                      FontSize="14"
                                      Background="DarkSlateBlue">
                                <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                                <Setter Property="Template">
                                                        <Setter.Value>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="4">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                </ControlTemplate>
                                                        </Setter.Value>
                                                </Setter>
                                        </Style>
                                </ToggleButton.Style>
                        </ToggleButton>
                </StackPanel>
                <!-- Status -->
                <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Đếm số lần start-->
                        <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="Fuchsia" BorderThickness="1" Margin="0 0 4 0" Padding="12">
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="Button - Số Lần Nhấn" FontSize="14" Foreground="DarkGreen" TextAlignment="Center"/>
                                        <TextBlock x:Name="StartCountText" Text="0" FontSize="26" Foreground="DeepSkyBlue" FontWeight="Bold" Margin="0 6 0 0" TextAlignment="Center"/>
                                </StackPanel>
                        </Border>
                        <!-- Vị trí motor -->
                        <Border Grid.Column="1" Background="White" CornerRadius="6" BorderBrush="Fuchsia" BorderThickness="1" Margin="4 0 4 0" Padding="12">
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="Repeat Button - Vị Trí Motor" FontSize="14" Foreground="DarkGreen" TextAlignment="Center"/>
                                        <TextBlock x:Name="JogCountText" Text="0" FontSize="26" Foreground="DeepSkyBlue" FontWeight="Bold" Margin="0 6 0 0" TextAlignment="Center"/>
                                </StackPanel>
                        </Border>
                        <!-- Trạng thái đèn -->
                        <Border Grid.Column="2" Background="White" CornerRadius="6" BorderBrush="Fuchsia" BorderThickness="1" Margin="4 0 4 0" Padding="12">
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="Toggle Button - Trạng Thái Đèn" FontSize="14" Foreground="DarkGreen" TextAlignment="Center"/>
                                        <TextBlock x:Name="LightStateText" Text="Tắt" FontSize="26" Foreground="DeepSkyBlue" FontWeight="Bold" Margin="0 6 0 0" TextAlignment="Center"/>
                                </StackPanel>
                        </Border>
                </Grid>
        </Grid>
</Window>
