<Window x:Class="Rotation_Checking_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision Rotation Inspector"
        Width="1480" Height="880"
        MinWidth="950" MinHeight="650"
        Background="#0B111E" Foreground="#E8EEF8">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="Background" Value="#24344D"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="#33496B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <!-- Ta có Cursor là Hand dùng để đổi hình dáng con trỏ chuột thành hình bàn tay chỉ ngón trỏ -->
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Resources>
        <Style TargetType="Border">
          <Setter Property="CornerRadius" Value="6"/>
        </Style>
      </Style.Resources>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10, 7"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Background" Value="#090E17"/>
      <Setter Property="Foreground" Value="#38BDF8"/> 
      <!-- Ta có CaretBrush là cái vạch đứng nhấp nháy sau khi gõ xong chữ -->
      <Setter Property="CaretBrush" Value="#FEFAF3"/> 
      <Setter Property="BorderBrush" Value="#263854"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Resources>
        <Style TargetType="Border">
          <Setter Property="CornerRadius" Value="6"/>
        </Style>
      </Style.Resources>
    </Style>
  </Window.Resources>
  <Grid Margin="22,18">
    <Grid.RowDefinitions>
      <!-- Tiêu đề -->
      <RowDefinition Height="Auto"/>
      <!-- Khung chọn thư mục ảnh ref và test -->
      <RowDefinition Height="Auto"/>
      <!-- Khu vực chính là danh sách và hai ảnh -->
      <RowDefinition Height="*"/>
      <!-- Thanh trạng thái dưới cùng -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!--Hàng 0 : Header tiêu đề-->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Vision Tool" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
        <Border Background="#1E293B" CornerRadius="4" Padding="8,3" Margin="12,3,0,0" VerticalAlignment="Center">
          <TextBlock Text="Roation Checking" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
        </Border>
      </StackPanel>
      <TextBlock Text="Hệ Thống Nhận Dạng Mẫu - Đo Góc Xoay - Hiển Thị Overlay" Foreground="#8B9EB7" FontSize="13" Margin="0,4,0,0"/>
    </StackPanel>
    <!--Hàng 1 : Khung điều khiển chọn thư mục ref và test-->
    <Border Grid.Row="1" Background="#131C2E" BorderBrush="#22304A" BorderThickness="1" CornerRadius="10" Padding="14,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Dòng chia area cho thư mục ref-->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="155"/>
          </Grid.ColumnDefinitions>
          <!--Dòng hiển thị cho thư mục ref-->
          <TextBlock Grid.Column="0" Text="📁 Ảnh Mẫu " FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" x:Name="RefPath"/>
          <Button Grid.Column="2" Content="Chọn Thư Mục Ref" Click="Btn_Browse_Ref_OnClick"/>
        </Grid>
        <!--Dòng chia area cho thư mục test và nút chạy-->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="155"/>
          </Grid.ColumnDefinitions>
          <!--Dòng hiển thị cho thư mục test-->
          <TextBlock Grid.Column="0" Text="📁 Ảnh Test" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" x:Name="TestPath"/>
          <Button Grid.Column="2" Content="Chọn Thư Mục Test" Click="Btn_Browse_Test_OnClick"/>
          <Button Grid.Column="3" x:Name="RunButton" Content="Chạy Tất Cả" Background="#2563EB" BorderBrush="#3B82F6" FontWeight="Bold" Click="Btn_Run_All_OnClick"/>
        </Grid>
      </Grid>
    </Border>
    <!--Hàng 2 : Khu vực chính với bên trái là danh sách còn bên phải là khung ảnh-->
    <Grid Grid.Row="2" Margin="0,14,0,12">
      <Grid.ColumnDefinitions>
        <!--Cột 0 là anh sách bảng kết quả-->
        <ColumnDefinition Width="260"/>
        <!--Cột 1 là khổng trống-->
        <ColumnDefinition Width="14"/>
        <!--Cột 2 là khu vực hiển thị 2 ành-->
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <!--Cột trái là khung danh sách kết quả-->
      <Border Grid.Column="0" Background="#131C2E" BorderBrush="#22304A" BorderThickness="1" CornerRadius="10" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Danh Sách Kết Quả" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" Margin="4,2,0,10"/>
          <ListBox Grid.Row="1" x:Name="Results" Background="Transparent" Foreground="#FEFAF3" BorderThickness="0" SelectionChanged="Sel_Change_OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#1A263D" CornerRadius="6" Padding="10,8" Margin="0,3" BorderBrush="#263854" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                    <TextBlock Text="{Binding Summary}" Foreground="#38BDF8" FontSize="12" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <!--Cột bên phải là khu vực xem ảnh và thông số-->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <!--Thanh công cụ overlay-->
          <RowDefinition Height="Auto"/> 
          <!--Khung ảnh song song-->
          <RowDefinition Height="*"/>
          <!--Chú thích màu sắc bên dưới-->
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Hàng con 0 : Thanh tùy chỉnh overlay và thông tin chi tiết-->
        <Border Grid.Row="0" Background="#131C2E" BorderBrush="#22304A" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,0,12">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="💾 Lưu Overlay PNG" Click="Btn_Save_Overlay_OnClick"/>
            <CheckBox x:Name="ShowOverlay" Content="Hiển thị lớp vẽ Overlay" IsChecked="True" Foreground="#E8EEF8" FontWeight="SemiBold" VerticalAlignment="Center" Checked="ShowOverlay_OnChecked" Unchecked="ShowOverlay_OnChecked"/>
            <TextBlock x:Name="Details" Margin="10,0" VerticalAlignment="Center" Foreground="#38BDF8" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </DockPanel>
        </Border>
        <!--Hàng con 1 : Hai khung ảnh đặt cạnh nhau-->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!--Khung ảnh bên trái : Ảnh tham chiếu-->
          <Border Grid.Column="0" Background="#131C2E" BorderBrush="#22304A" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Ảnh Tham Chiếu (Reference)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock x:Name="ReferenceName" Text="Mẫu tương ứng với kết quả được chọn" Foreground="#8B9EB7" FontSize="12.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Border Grid.Row="1" Background="#070B12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="8">
                <Image x:Name="ReferencePreview" Stretch="Uniform"/>
              </Border>
            </Grid>
          </Border>
          <!--Khung ảnh bên phải : Ảnh test và kết quả-->
          <Border Grid.Column="2" Background="#131C2E" BorderBrush="#22304A" BorderThickness="1" CornerRadius="10" Padding="14"> 
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Ảnh Kiểm Tra (Test And Overlay)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock x:Name="TestName" Text="Ảnh kiểm tra và overlay góc xoay" Foreground="#8B9EB7" FontSize="12.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Border Grid.Row="1" Background="#070B12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="8">
                <Image x:Name="TestPreview" Stretch="Uniform"/>
              </Border>
            </Grid>
          </Border>
        </Grid>
        <!--Hàng con 2 : Chú thích màu sắc trực quan-->
        <Border Grid.Row="2" Background="#131C2E" BorderBrush="#22304A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
          <TextBlock Text="Quy ước là chiều dương là cùng chiều kim đồng hồ" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#94A3B8" FontSize="12.5"/>
        </Border>
      </Grid>
    </Grid>
    <!--Hàng con 3 : Thanh trạng thái ở dưới cùng-->
    <Border Grid.Row="3" Background="#131C2E" BorderBrush="#22304A" BorderThickness="1" CornerRadius="8" Padding="14,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="CancelButton" Content="⏹ Dừng" Background="#7F1D1D" BorderBrush="#991B1B" Click="Btn_Cancel_OnClick" IsEnabled="False"/>
        <TextBlock x:Name="Status" Text="Sẵn sàng vui lòng chọn thư mục và nhấn chạy tất cả để bắt đầu" FontWeight ="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12.5"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>